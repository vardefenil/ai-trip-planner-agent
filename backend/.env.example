# Environment Variables — Copy this to .env and fill in your keys

# ============================================================
# REQUIRED: Google Gemini API Key
# Get it from: https://aistudio.google.com/app/apikey
# ============================================================
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================
# REQUIRED: Google Places API Key
# Get it from: https://console.cloud.google.com/
# Enable: Places API, Maps JavaScript API
# ============================================================
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# ============================================================
# OPTIONAL: Amadeus API (for real flight search)
# Get it from: https://developers.amadeus.com/
# ============================================================
AMADEUS_API_KEY=your_amadeus_api_key_here
AMADEUS_API_SECRET=your_amadeus_api_secret_here

# ============================================================
# App Config
# ============================================================
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
